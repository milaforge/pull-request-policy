# Pull Request Policy sample configuration.
# Copy this file to .github/pull-request-policy.yml and remove policies you do
# not need. The policy map below is the recommended starting point.

policies:
  auth:
    when:
      changed: src/auth/**
    require:
      approvals: 2

# Additional examples
#
# To use one of these, replace the policies section above with the complete
# example. Policies support optional severity, messages, descriptions, and
# combinators while retaining the same map syntax.
#
## Require tests or failure-mode documentation for queue changes:
# policies:
#   - id: queue-change-requires-tests
#     severity: error
#     when:
#       changed:
#         - 'runtime/queue/**'
#         - 'runtime/store/**'
#     require:
#       any:
#         - changed:
#             - 'tests/**'
#         - changed:
#             - 'failure_modes/**'
#     message: 'Queue/store changes require tests or failure-mode updates.'
#
## Require a changelog or exemption label for public API changes:
# policies:
#   - id: public-api-change-needs-changelog
#     severity: warn
#     when:
#       changed:
#         - 'api/public/**'
#     require:
#       any:
#         - changed:
#             - 'CHANGELOG.md'
#         - has_label:
#             - 'release-note-exempt'
#     message: 'Public API changes require a changelog update or exemption label.'
#
## Require a deploy label unless the policy-exempt label is present:
# policies:
#   - id: deploy-label-required-unless-exempt
#     severity: warn
#     when:
#       all:
#         - changed:
#             - '.github/workflows/**'
#         - not:
#             has_label:
#               - 'policy-exempt'
#     require:
#       has_label:
#         - 'deploy-change'
#     message: 'Workflow changes should carry a deploy-change label unless policy-exempt.'
#
## Require rollback or runbook text in workflow-change pull requests:
# policies:
#   - id: deploy-change-needs-rollback-text
#     severity: warn
#     when:
#       changed:
#         - '.github/workflows/**'
#     require:
#       body:
#         - rollback
#         - runbook
#     message: 'Workflow changes should mention rollback or runbook context in the PR body.'
